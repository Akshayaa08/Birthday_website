# Server Configuration
PORT=5000
NODE_ENV=development

# Long random values; never add real credentials to Vite-prefixed variables.
SESSION_SECRET=replace-with-at-least-32-random-bytes
OWNER_PASSWORD=replace-with-a-long-owner-password
BOYFRIEND_PASSWORD=replace-with-a-long-boyfriend-password

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/birthday_journey

# Cloudinary Configuration (Get these from your Cloudinary dashboard: https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional API origin when the API is hosted separately; do not put secrets in VITE_* variables.
# Vercel frontend build: use the Render origin, without a trailing slash or /api.
# VITE_API_BASE_URL=https://birthday-website-bou8.onrender.com
# VITE_API_URL is also supported for existing deployments.
